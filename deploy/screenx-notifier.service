[Unit]
Description=CGV ScreenX 예매 오픈 알림 봇
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/movie-club-ticket-notifier
ExecStart=/home/ubuntu/movie-club-ticket-notifier/.venv/bin/python main.py

# 죽어도 10초 뒤 자동 재시작 (예매 오픈 시점을 놓치지 않기 위함)
Restart=always
RestartSec=10

# 로그는 journalctl로 확인: journalctl -u screenx-notifier -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=screenx-notifier

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
