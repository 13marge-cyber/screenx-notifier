[Unit]
Description=CGV ScreenX 예매 오픈 알림 봇
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/screenx
ExecStart=/home/opc/screenx/.venv/bin/python main.py

# 죽어도 10초 뒤 자동 재시작 (예매 오픈 시점을 놓치지 않기 위함)
Restart=always
RestartSec=10

# 1/8 OCPU짜리 약한 인스턴스라, 봇이 폭주해도 sshd가 굶지 않도록
# CPU 사용량에 상한을 둡니다. (평상시엔 훨씬 적게 씁니다)
CPUQuota=40%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=screenx-notifier

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
